    "faq": {
      "type": "faq",
      "blocks": {
        "f1": {
          "type": "faq",
          "settings": {
            "question": "How much protein does it actually have?",
            "answer": "<p>A 32g serving of the powder gives about 11g of protein. Prepared with roughly 200ml of milk as directed, the finished drink comes to about 17g.</p>"
          }
        },
        "f2": {
          "type": "faq",
          "settings": {
            "question": "How many servings are in a pouch?",
            "answer": "<p>Each 250g pouch delivers roughly 8 servings at the suggested 32g serving size.</p>"
          }
        },
        "f3": {
          "type": "faq",
          "settings": {
            "question": "What is the shelf life?",
            "answer": "<p>90 days from the packaging date. Store in an airtight container in a cool, dry place away from direct sunlight.</p>"
          }
        },
        "f4": {
          "type": "faq",
          "settings": {
            "question": "Are there allergens?",
            "answer": "<p>Yes. NutriDates contains oats, nuts and soy, and is manufactured in a facility that also processes dairy and whey.</p>"
          }
        },
        "f5": {
          "type": "faq",
          "settings": {
            "question": "Can I make it with water?",
            "answer": "<p>You can, but the drink is designed for milk. The 17g protein figure applies to the version prepared with milk as directed.</p>"
          }
        }
