<section class="section{% if section.settings.background == 'cream' %} section--cream{% elsif section.settings.background == 'beige' %} section--beige{% elsif section.settings.background == 'cocoa' %} section--cocoa{% endif %}">
  <div class="page-width">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="section-head__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="steps__item reveal" {{ block.shopify_attributes }}>
          <div class="steps__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 700 }}"
                   alt="{{ block.settings.image.alt | escape }}" loading="lazy"
                   width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
            {%- else -%}
              <div class="steps__placeholder">{{ forloop.index }}</div>
            {%- endif -%}
            <span class="steps__num">Step {{ forloop.index }}</span>
          </div>
          <h3 class="steps__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="steps__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.cta_text != blank -%}
      <div class="text-center" style="margin-top:clamp(28px,3vw,44px);">
        <a href="{{ section.settings.cta_url }}" class="btn btn--gold btn--lg">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .steps{ display:grid; gap:clamp(20px,3vw,36px); grid-template-columns:repeat({{ section.blocks.size }},1fr); counter-reset:step; }
  .steps__item{ text-align:center; }
  .steps__media{ position:relative; border-radius:var(--r-xl); overflow:hidden; aspect-ratio:4/3; background:var(--nd-beige); margin-bottom:18px; }
  .steps__media img{ width:100%; height:100%; object-fit:cover; }
  .steps__placeholder{
    display:grid; place-items:center; height:100%;
    font-family:var(--font-heading-family,"Poppins",sans-serif);
    font-size:4rem; font-weight:800; color:rgba(58,32,23,.18);
    background:linear-gradient(140deg,var(--nd-beige),var(--nd-cream));
  }
  .steps__num{
    position:absolute; top:14px; left:14px;
    background:var(--nd-cocoa); color:var(--nd-cream);
    padding:6px 14px; border-radius:var(--r-pill);
    font-size:var(--fs-xs); font-weight:800; letter-spacing:.1em; text-transform:uppercase;
  }
  .steps__title{ font-size:1.15rem; margin-bottom:.35em; }
  .steps__text{ color:var(--text-muted); font-size:.95rem; margin:0; max-width:34ch; margin-inline:auto; }
  .section--cocoa .steps__text{ color:rgba(255,246,233,.7); }
  /* Mobile: all steps on one line with small square media (GOAT Life pattern) */
  @media (max-width:749px){
    .steps{ grid-template-columns:repeat({{ section.blocks.size }},1fr); gap:10px; align-items:start; }
    .steps__media{ aspect-ratio:1/1; border-radius:var(--r-md); margin-bottom:10px; }
    .steps__placeholder{ font-size:2rem; }
    .steps__num{
      position:static; display:inline-block; margin-bottom:6px;
      padding:3px 8px; font-size:9px; letter-spacing:.06em;
    }
    .steps__item{ display:flex; flex-direction:column; }
    .steps__item .steps__num{ order:-1; align-self:center; }
    .steps__title{ font-size:13px; margin-bottom:.25em; }
    .steps__text{ font-size:11px; line-height:1.35; }
  }
</style>

{% schema %}
{
  "name": "How to prepare",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "30-second ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A milkshake in three steps." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "One 32g serving is roughly 2 heaped scoops." },
    { "type": "text", "id": "cta_text", "label": "Button text" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "Warm white" },
        { "value": "cream", "label": "Warm cream" },
        { "value": "beige", "label": "Soft beige" },
        { "value": "cocoa", "label": "Cocoa" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Add the powder" },
        { "type": "text", "id": "text", "label": "Text", "default": "Two heaped scoops (about 32g)." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to prepare",
      "blocks": [
        { "type": "step", "settings": { "title": "Scoop", "text": "Add 2 heaped scoops (about 32g) of NutriDates." } },
        { "type": "step", "settings": { "title": "Pour", "text": "Add roughly 200ml of cold or warm milk." } },
        { "type": "step", "settings": { "title": "Shake & sip", "text": "Shake or blend for 10 seconds. Done." } }
      ]
    }
  ]
}
{% endschema %}
