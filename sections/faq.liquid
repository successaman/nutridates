<section class="section{% if section.settings.background == 'cream' %} section--cream{% elsif section.settings.background == 'beige' %} section--beige{% elsif section.settings.background == 'cocoa' %} section--cocoa{% endif %}">
  <div class="page-width page-width--narrow">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="section-head__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="accordion reveal">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="accordion__summary">
            {{ block.settings.question }}
            <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
          </summary>
          <div class="accordion__content">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="text-center" style="margin-top:36px;">
        <a href="{{ section.settings.cta_url }}" class="btn btn--outline">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%}FAQ structured data{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you might ask." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "text", "id": "cta_text", "label": "Button text" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "Warm white" },
        { "value": "cream", "label": "Warm cream" },
        { "value": "beige", "label": "Soft beige" },
        { "value": "cocoa", "label": "Cocoa" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How much protein does it actually have?" },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>A 32g serving of the powder gives about 11g of protein. Prepared with roughly 200ml of milk as directed, the finished drink comes to about 17g.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq" },
        {
          "type": "faq",
          "settings": {
            "question": "How many servings are in a pouch?",
            "answer": "<p>Each 250g pouch delivers roughly 8 servings at the suggested 32g serving size.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What is the shelf life?",
            "answer": "<p>90 days from the packaging date. Store in an airtight container in a cool, dry place away from direct sunlight.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Are there allergens?",
            "answer": "<p>Yes. NutriDates contains oats, nuts and soy, and is manufactured in a facility that also processes dairy and whey.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I make it with water?",
            "answer": "<p>You can, but the drink is designed for milk. The 17g protein figure applies to the version prepared with milk as directed.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
