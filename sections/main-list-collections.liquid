<section class="section">
  <div class="page-width">
    <div class="section-head reveal">
      <h1 class="section-head__title">Collections</h1>
    </div>
    <div class="grid grid--3">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="reveal" style="display:block;border-radius:var(--r-lg);overflow:hidden;border:1px solid var(--line);background:var(--surface);">
          <div style="aspect-ratio:4/3;background:var(--nd-beige);">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}"
                   loading="lazy" style="width:100%;height:100%;object-fit:cover;">
            {%- endif -%}
          </div>
          <div style="padding:20px;">
            <h2 style="font-size:1.1rem;margin:0;">{{ collection.title }}</h2>
            <p class="muted" style="font-size:var(--fs-xs);margin:6px 0 0;">{{ collection.products_count }} products</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
