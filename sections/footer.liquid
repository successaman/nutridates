<footer class="footer">
  <div class="page-width">

    {%- comment -%} Newsletter + brand blurb sit at the top, as on GOAT Life {%- endcomment -%}
    <div class="footer__top">
      <div class="footer__brand">
        {%- if settings.logo -%}
          <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}"
               style="width:{{ settings.logo_width }}px;margin-bottom:12px;">
        {%- else -%}
          <p class="footer__brand-name">{{ shop.name }}</p>
        {%- endif -%}
        <p class="footer__tagline">{{ settings.brand_tagline }}</p>
        <p class="footer__blurb">{{ settings.brand_blurb }}</p>
      </div>

      {%- if section.settings.show_newsletter -%}
        <div class="footer__newsletter">
          <p class="footer__heading">{{ section.settings.newsletter_heading }}</p>
          <p class="footer__blurb">{{ section.settings.newsletter_text }}</p>
          {%- form 'customer', class: 'newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter__form">
              <input class="newsletter__input" type="email" name="contact[email]"
                     placeholder="Your email" required aria-label="Email">
              <button type="submit" class="btn btn--primary btn--sm">Join</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="footer__success">Thanks for subscribing.</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Link columns — accordion on mobile, columns on desktop {%- endcomment -%}
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'menu' -%}
            <details class="footer__col" {{ block.shopify_attributes }} open>
              <summary class="footer__heading">
                {{ block.settings.heading }}
                <span class="footer__chev">{% render 'icon', name: 'chevron' %}</span>
              </summary>
              <ul class="footer__list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </details>

          {%- when 'text' -%}
            <details class="footer__col" {{ block.shopify_attributes }} open>
              <summary class="footer__heading">
                {{ block.settings.heading }}
                <span class="footer__chev">{% render 'icon', name: 'chevron' %}</span>
              </summary>
              <div class="footer__blurb">{{ block.settings.text }}</div>
            </details>

          {%- when 'social' -%}
            <details class="footer__col" {{ block.shopify_attributes }} open>
              <summary class="footer__heading">
                {{ block.settings.heading }}
                <span class="footer__chev">{% render 'icon', name: 'chevron' %}</span>
              </summary>
              <ul class="footer__list">
                {%- if settings.social_instagram != blank -%}
                  <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>
                {%- endif -%}
                {%- if settings.social_facebook != blank -%}
                  <li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a></li>
                {%- endif -%}
                {%- if settings.social_youtube != blank -%}
                  <li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener">YouTube</a></li>
                {%- endif -%}
                {%- if settings.social_whatsapp != blank -%}
                  <li><a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener">WhatsApp</a></li>
                {%- endif -%}
              </ul>
            </details>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="footer__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | upcase }}. ALL RIGHTS RESERVED.</span>
      <span class="footer__policies">
        {%- if section.settings.show_policies -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endif -%}
          {%- endfor -%}
        {%- endif -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_policies", "label": "Show store policies", "default": true },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Get the good stuff" },
    { "type": "text", "id": "newsletter_text", "label": "Text", "default": "Recipes, launches and offers. No spam." },
    { "type": "header", "content": "Legal" },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "NutriDates products are designed to support a balanced everyday diet and are not intended to diagnose, treat, cure or prevent any disease."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "SHOP" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "MADE IN INDIA" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Crafted in Hazaribagh, Jharkhand.</p>" }
      ]
    },
    {
      "type": "social",
      "name": "Social column",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "FOLLOW" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "SHOP" } },
      { "type": "menu", "settings": { "heading": "QUICK LINKS" } },
      { "type": "menu", "settings": { "heading": "POLICIES" } },
      { "type": "social", "settings": { "heading": "FOLLOW" } }
    ]
  },
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
