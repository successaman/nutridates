<section class="section{% if section.settings.background == 'cream' %} section--cream{% elsif section.settings.background == 'beige' %} section--beige{% elsif section.settings.background == 'cocoa' %} section--cocoa{% endif %}">
  <div class="page-width">
    <div class="iwt iwt--{{ section.settings.image_position }}">
      <div class="iwt__media reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}"
               srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                       {{ section.settings.image | image_url: width: 1200 }} 1200w"
               sizes="(min-width:990px) 46vw, 92vw"
               alt="{{ section.settings.image.alt | escape }}" loading="lazy"
               width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
        {%- else -%}
          <div class="iwt__placeholder"></div>
        {%- endif -%}
        {%- if section.settings.float_stat != blank -%}
          <div class="iwt__float">
            <strong>{{ section.settings.float_stat }}</strong>
            <span>{{ section.settings.float_label }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="iwt__content reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="section-head__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="iwt__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="iwt__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="iwt__tick">{% render 'icon', name: 'check' %}</span>
                <span>
                  <strong>{{ block.settings.title }}</strong>
                  {%- if block.settings.text != blank %}<br><span class="muted">{{ block.settings.text }}</span>{% endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url }}" class="btn btn--{% if section.settings.background == 'cocoa' %}gold{% else %}primary{% endif %}">{{ section.settings.cta_text }}</a>
        {%- endif -%}

        {%- if section.settings.disclaimer != blank -%}
          <p class="muted" style="font-size:var(--fs-xs);margin-top:18px;">{{ section.settings.disclaimer }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .iwt{ display:grid; gap:clamp(28px,4vw,64px); align-items:center; grid-template-columns:1fr 1fr; }
  .iwt--right .iwt__media{ order:2; }
  .iwt__media{ position:relative; border-radius:var(--r-xl); overflow:hidden; aspect-ratio:{{ section.settings.image_ratio }}; background:var(--nd-beige); }
  .iwt__media img{ width:100%; height:100%; object-fit:cover; }
  .iwt__placeholder{ width:100%; height:100%; background:linear-gradient(140deg,var(--nd-beige),var(--nd-cream)); }
  .iwt__float{
    position:absolute; bottom:18px; left:18px;
    background:var(--nd-white); border-radius:var(--r-md); padding:12px 18px;
    box-shadow:var(--shadow-md); display:flex; flex-direction:column; line-height:1.2;
  }
  .iwt__float strong{ font-family:var(--font-heading-family,"Poppins",sans-serif); font-size:1.5rem; color:var(--nd-cocoa-deep); }
  .iwt__float span{ font-size:var(--fs-xs); color:var(--text-muted); text-transform:uppercase; letter-spacing:.08em; font-weight:700; }
  .iwt__text{ color:var(--text-muted); font-size:1.02rem; }
  .section--cocoa .iwt__text,.section--cocoa .muted{ color:rgba(255,246,233,.72); }
  .iwt__list{ display:grid; gap:14px; margin:24px 0 28px; }
  .iwt__list li{ display:flex; gap:12px; align-items:flex-start; font-size:.97rem; }
  .iwt__tick{
    flex:none; display:grid; place-items:center; width:24px; height:24px; margin-top:2px;
    border-radius:var(--r-pill); background:var(--nd-gold); color:var(--nd-cocoa-deep);
  }
  .iwt__tick svg{ width:14px; height:14px; }
  @media (max-width:749px){
    .iwt{ grid-template-columns:1fr; }
    .iwt--right .iwt__media{ order:0; }
  }
</style>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait" },
        { "value": "4/3", "label": "Landscape" }
      ],
      "default": "4/5"
    },
    { "type": "text", "id": "float_stat", "label": "Floating stat value" },
    { "type": "text", "id": "float_label", "label": "Floating stat label" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The protein bit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "17g protein when made with milk." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A 32g serving of NutriDates gives you about 11g of protein. Prepared with roughly 200ml of milk as directed, the finished drink lands around 17g.</p>"
    },
    { "type": "text", "id": "cta_text", "label": "Button text" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text", "id": "disclaimer", "label": "Small print", "default": "Protein value of the prepared drink depends on the milk used." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "Warm white" },
        { "value": "cream", "label": "Warm cream" },
        { "value": "beige", "label": "Soft beige" },
        { "value": "cocoa", "label": "Cocoa" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Soya protein isolate" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
