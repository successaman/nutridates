<div class="marquee" style="--marquee-speed:{{ section.settings.speed }}s;{% if section.settings.color_scheme == 'cocoa' %}background:var(--nd-cocoa);color:var(--nd-cream);{% elsif section.settings.color_scheme == 'beige' %}background:var(--nd-beige);color:var(--nd-cocoa-deep);{% endif %}">
  <div class="marquee__track" data-marquee>
    {%- assign items = section.settings.text | split: '·' -%}
    {%- for i in (1..6) -%}
      {%- for item in items -%}
        <span class="marquee__item">{{ item | strip }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Dates · Cocoa · Protein · Everyday nutrition",
      "info": "Separate phrases with a middle dot ·"
    },
    { "type": "range", "id": "speed", "min": 15, "max": 90, "step": 1, "unit": "s", "label": "Loop duration", "default": 34 },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour",
      "options": [
        { "value": "gold", "label": "Nutri gold" },
        { "value": "cocoa", "label": "Cocoa" },
        { "value": "beige", "label": "Soft beige" }
      ],
      "default": "gold"
    }
  ],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
