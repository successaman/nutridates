<section class="section section--tight{% if section.settings.background == 'cream' %} section--cream{% elsif section.settings.background == 'beige' %} section--beige{% elsif section.settings.background == 'cocoa' %} section--cocoa{% endif %}">
  <div class="page-width">
    <ul class="icon-strip">
      {%- for block in section.blocks -%}
        <li class="icon-strip__item reveal" {{ block.shopify_attributes }}>
          <span class="icon-strip__icon">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 96 }}" alt="" width="28" height="28" loading="lazy">
            {%- else -%}
              {% render 'icon', name: block.settings.icon %}
            {%- endif -%}
          </span>
          <span class="icon-strip__text">
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.text != blank %}<span>{{ block.settings.text }}</span>{% endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .icon-strip{ display:grid; gap:clamp(14px,2vw,28px); grid-template-columns:repeat({{ section.blocks.size }},1fr); }
  .icon-strip__item{ display:flex; align-items:center; gap:14px; }
  .icon-strip__icon{
    flex:none; display:grid; place-items:center; width:48px; height:48px;
    border-radius:var(--r-pill); background:rgba(245,166,35,.2); color:var(--nd-date);
  }
  .section--cocoa .icon-strip__icon{ background:rgba(245,166,35,.18); color:var(--nd-gold); }
  .icon-strip__icon svg{ width:24px; height:24px; }
  .icon-strip__text{ display:flex; flex-direction:column; line-height:1.35; }
  .icon-strip__text strong{ font-family:var(--font-heading-family,"Poppins",sans-serif); font-size:.95rem; }
  .icon-strip__text span{ font-size:var(--fs-xs); color:var(--text-muted); }
  .section--cocoa .icon-strip__text span{ color:rgba(255,246,233,.65); }
  @media (max-width:989px){ .icon-strip{ grid-template-columns:repeat(2,1fr); } }
  @media (max-width:520px){ .icon-strip{ grid-template-columns:1fr; } }
</style>

{% schema %}
{
  "name": "Benefits strip",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "Warm white" },
        { "value": "cream", "label": "Warm cream" },
        { "value": "beige", "label": "Soft beige" },
        { "value": "cocoa", "label": "Cocoa" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "bolt", "label": "Bolt" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Delivery" },
            { "value": "star", "label": "Star" },
            { "value": "check", "label": "Check" }
          ],
          "default": "bolt"
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon image" },
        { "type": "text", "id": "title", "label": "Title", "default": "17g protein with milk" },
        { "type": "text", "id": "text", "label": "Text", "default": "Prepared as directed" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "bolt", "title": "17g protein with milk", "text": "Prepared as directed" } },
        { "type": "item", "settings": { "icon": "leaf", "title": "Dates, oats & cocoa", "text": "Real ingredients" } },
        { "type": "item", "settings": { "icon": "star", "title": "Ready in 30 seconds", "text": "Shake and go" } },
        { "type": "item", "settings": { "icon": "truck", "title": "Shipped across India", "text": "From Hazaribagh" } }
      ]
    }
  ]
}
{% endschema %}
