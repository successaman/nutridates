<section class="section{% if section.settings.background == 'cream' %} section--cream{% elsif section.settings.background == 'beige' %} section--beige{% elsif section.settings.background == 'cocoa' %} section--cocoa{% endif %}">
  <div class="page-width">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="section-head__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="scroller scroller--desktop-grid" style="--cols:{{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <figure class="quote reveal{% if block.settings.video != blank or block.settings.video_url != blank %} quote--video{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            <div class="quote__media">
              {{ block.settings.video | video_tag: image_size: '600x', controls: true, muted: false, playsinline: true }}
            </div>
          {%- elsif block.settings.video_url != blank -%}
            <div class="quote__media quote__media--embed">
              {%- if block.settings.video_poster != blank -%}
                <img src="{{ block.settings.video_poster | image_url: width: 600 }}" alt="" loading="lazy">
              {%- endif -%}
              <a class="quote__play" href="{{ block.settings.video_url }}" target="_blank" rel="noopener" aria-label="Play video review">
                <span></span>
              </a>
            </div>
          {%- elsif block.settings.show_video_placeholder -%}
            <div class="quote__media quote__media--empty">
              <span class="quote__play" aria-hidden="true"><span></span></span>
              <span class="quote__placeholder-label">Video review</span>
            </div>
          {%- endif -%}
          {%- if block.settings.rating > 0 -%}
            <div class="quote__stars" aria-label="{{ block.settings.rating }} out of 5">
              {%- for i in (1..block.settings.rating) -%}{% render 'icon', name: 'star' %}{%- endfor -%}
            </div>
          {%- endif -%}
          <blockquote class="quote__text">{{ block.settings.text }}</blockquote>
          <figcaption class="quote__by">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 96 }}" alt="" width="40" height="40" loading="lazy">
            {%- endif -%}
            <span>
              <strong>{{ block.settings.name }}</strong>
              {%- if block.settings.role != blank %}<span class="quote__role">{{ block.settings.role }}</span>{% endif -%}
            </span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .quote{
    display:flex; flex-direction:column; gap:14px; margin:0; height:100%;
    padding:26px 24px; border-radius:var(--r-lg);
    background:var(--surface); border:1px solid var(--line);
  }
  .section--cocoa .quote{ background:rgba(255,246,233,.06); border-color:rgba(255,246,233,.14); }
  .quote__media{
    position:relative; aspect-ratio:9/16; max-height:340px; overflow:hidden;
    border-radius:var(--r-md); background:var(--nd-beige); margin-bottom:4px;
  }
  .quote__media video,.quote__media img{ width:100%; height:100%; object-fit:cover; display:block; }
  .quote__media--empty{
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;
    border:1.5px dashed var(--line-strong); background:transparent;
  }
  .quote__placeholder-label{ font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--text-muted); }
  .quote__play{
    position:absolute; inset:0; margin:auto; width:52px; height:52px;
    display:grid; place-items:center; border-radius:var(--r-pill);
    background:var(--nd-gold); box-shadow:var(--shadow-md);
  }
  .quote__media--empty .quote__play{ position:static; width:44px; height:44px; box-shadow:none; }
  .quote__play span{
    width:0; height:0; margin-left:3px;
    border-top:9px solid transparent; border-bottom:9px solid transparent;
    border-left:14px solid var(--nd-cocoa-deep);
  }
  .quote__stars{ display:flex; gap:2px; color:var(--nd-gold); }
  .quote__stars svg{ width:16px; height:16px; }
  .quote__text{
    margin:0; font-size:1rem; line-height:1.55; color:var(--text);
    font-family:var(--font-heading-family,"Poppins",sans-serif); font-weight:500;
  }
  .section--cocoa .quote__text{ color:var(--nd-cream); }
  .quote__by{ display:flex; align-items:center; gap:12px; margin-top:auto; padding-top:8px; }
  .quote__by img{ border-radius:var(--r-pill); object-fit:cover; width:40px; height:40px; }
  .quote__by strong{ display:block; font-size:.92rem; }
  .quote__role{ display:block; font-size:var(--fs-xs); color:var(--text-muted); }
  .section--cocoa .quote__role{ color:rgba(255,246,233,.6); }
</style>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real sips" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by people who skip breakfast." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Desktop columns", "default": 3 },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "Warm white" },
        { "value": "cream", "label": "Warm cream" },
        { "value": "beige", "label": "Soft beige" },
        { "value": "cocoa", "label": "Cocoa" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review", "default": "Tastes like a treat but actually keeps me full till lunch." },
        { "type": "text", "id": "name", "label": "Name", "default": "Priya" },
        { "type": "text", "id": "role", "label": "Role / city", "default": "Student, Ranchi" },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "header", "content": "Video review" },
        { "type": "video", "id": "video", "label": "Upload a video" },
        { "type": "video_url", "id": "video_url", "label": "Or paste a YouTube / Vimeo link", "accept": ["youtube", "vimeo"] },
        { "type": "image_picker", "id": "video_poster", "label": "Video thumbnail (for the link option)" },
        { "type": "checkbox", "id": "show_video_placeholder", "label": "Show empty video placeholder", "default": false, "info": "Useful while you are still collecting customer videos." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "quote" },
        { "type": "quote" },
        { "type": "quote" }
      ]
    }
  ]
}
{% endschema %}
