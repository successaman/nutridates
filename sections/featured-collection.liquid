{%- liquid
  assign collection = collections[section.settings.collection]
  assign products = collection.products
  assign count = section.settings.products_to_show
-%}

<section class="section{% if section.settings.background == 'cream' %} section--cream{% elsif section.settings.background == 'beige' %} section--beige{% elsif section.settings.background == 'cocoa' %} section--cocoa{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-head reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-head__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-head__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-head__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="scroller scroller--desktop-grid" style="--cols:{{ section.settings.columns }};">
      {%- if products.size > 0 -%}
        {%- for product in products limit: count -%}
          <div class="reveal">{% render 'product-card', product: product %}</div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="reveal">{% render 'product-card', placeholder: true %}</div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="text-center" style="margin-top:32px;">
        <a href="{{ collection.url }}" class="btn btn--outline">View all products</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 16, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": true },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your NutriDates." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Date-powered nutrition that actually tastes like a treat." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "Warm white" },
        { "value": "cream", "label": "Warm cream" },
        { "value": "beige", "label": "Soft beige" },
        { "value": "cocoa", "label": "Cocoa" }
      ],
      "default": "white"
    }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
