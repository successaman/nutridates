{%- comment -%}
  Versatile card grid — used for ingredients, occasions, "why NutriDates",
  recipes and audience segments.
{%- endcomment -%}

<section class="section{% if section.settings.background == 'cream' %} section--cream{% elsif section.settings.background == 'beige' %} section--beige{% elsif section.settings.background == 'cocoa' %} section--cocoa{% endif %}">
  <div class="page-width">
    <div class="section-head{% if section.settings.heading_align == 'left' %} section-head--left{% endif %} reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="section-head__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="{% if section.settings.layout == 'scroll' %}scroller scroller--desktop-grid{% else %}grid{% endif %} cc" style="--cols:{{ section.settings.columns }};grid-template-columns:repeat({{ section.settings.columns }},1fr);">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="cc__card cc__card--{{ section.settings.style }} reveal" {{ block.shopify_attributes }}>{%- else -%}<div class="cc__card cc__card--{{ section.settings.style }} reveal" {{ block.shopify_attributes }}>{%- endif -%}

          {%- if section.settings.style != 'plain' and block.settings.image != blank -%}
            <div class="cc__media">
              <img src="{{ block.settings.image | image_url: width: 800 }}"
                   alt="{{ block.settings.image.alt | escape }}" loading="lazy"
                   width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
              {%- if block.settings.tag != blank -%}<span class="cc__tag">{{ block.settings.tag }}</span>{%- endif -%}
            </div>
          {%- elsif section.settings.style == 'plain' -%}
            <span class="cc__icon">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 120 }}" alt="" width="32" height="32" loading="lazy">
              {%- else -%}
                {% render 'icon', name: 'leaf' %}
              {%- endif -%}
            </span>
          {%- endif -%}

          <div class="cc__body">
            {%- if block.settings.tag != blank and section.settings.style == 'plain' -%}
              <span class="chip chip--gold">{{ block.settings.tag }}</span>
            {%- endif -%}
            <h3 class="cc__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="cc__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>

        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="text-center" style="margin-top:clamp(28px,3vw,44px);">
        <a href="{{ section.settings.cta_url }}" class="btn btn--{% if section.settings.background == 'cocoa' %}gold{% else %}outline{% endif %}">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .cc__card{
    display:flex; flex-direction:column; height:100%;
    border-radius:var(--r-lg); overflow:hidden;
    transition:transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .cc__card--boxed{ background:var(--surface); border:1px solid var(--line); }
  .cc__card--plain{ background:var(--surface); border:1px solid var(--line); padding:26px 24px; }
  .section--cocoa .cc__card--boxed,
  .section--cocoa .cc__card--plain{ background:rgba(255,246,233,.06); border-color:rgba(255,246,233,.14); }
  a.cc__card:hover{ transform:translateY(-4px); box-shadow:var(--shadow-md); }

  .cc__media{ position:relative; aspect-ratio:{{ section.settings.image_ratio }}; background:var(--nd-beige); overflow:hidden; }
  .cc__media img{ width:100%; height:100%; object-fit:cover; transition:transform .5s var(--ease); }
  a.cc__card:hover .cc__media img{ transform:scale(1.05); }
  .cc__tag{
    position:absolute; top:12px; left:12px;
    background:var(--nd-white); color:var(--nd-cocoa-deep);
    padding:5px 12px; border-radius:var(--r-pill);
    font-size:var(--fs-xs); font-weight:800; letter-spacing:.04em;
  }
  .cc__icon{
    display:grid; place-items:center; width:52px; height:52px; margin-bottom:16px;
    border-radius:var(--r-md); background:rgba(245,166,35,.2); color:var(--nd-date);
  }
  .section--cocoa .cc__icon{ color:var(--nd-gold); }
  .cc__icon svg{ width:26px; height:26px; }
  .cc__card--boxed .cc__body{ padding:20px 20px 24px; }
  .cc__title{ font-size:1.08rem; margin-bottom:.4em; }
  .cc__text{ color:var(--text-muted); font-size:.93rem; margin:0; }
  .section--cocoa .cc__text{ color:rgba(255,246,233,.68); }
  @media (max-width:989px){ .cc{ grid-template-columns:repeat(2,1fr)!important; } }
  @media (max-width:600px){ .cc{ grid-template-columns:1fr!important; } }
</style>

{% schema %}
{
  "name": "Card grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the pouch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ingredients you can pronounce." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Card style",
      "options": [
        { "value": "boxed", "label": "Image card" },
        { "value": "plain", "label": "Icon card" }
      ],
      "default": "boxed"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Mobile layout",
      "options": [
        { "value": "grid", "label": "Stacked grid" },
        { "value": "scroll", "label": "Horizontal scroll" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Desktop columns", "default": 4 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait" },
        { "value": "4/3", "label": "Landscape" }
      ],
      "default": "4/3"
    },
    { "type": "text", "id": "cta_text", "label": "Button text" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "Warm white" },
        { "value": "cream", "label": "Warm cream" },
        { "value": "beige", "label": "Soft beige" },
        { "value": "cocoa", "label": "Cocoa" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "tag", "label": "Tag" },
        { "type": "text", "id": "title", "label": "Title", "default": "Dates" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Natural sweetness and fibre, straight from the fruit." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Card grid",
      "blocks": [
        { "type": "card", "settings": { "title": "Dates", "text": "Natural sweetness, fibre and warmth." } },
        { "type": "card", "settings": { "title": "Cocoa", "text": "The chocolate taste that makes it a habit." } },
        { "type": "card", "settings": { "title": "Oats", "text": "Slow, steady carbohydrates." } },
        { "type": "card", "settings": { "title": "Soya protein isolate", "text": "The protein backbone of every serving." } }
      ]
    }
  ]
}
{% endschema %}
