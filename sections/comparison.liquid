<section class="section{% if section.settings.background == 'cream' %} section--cream{% elsif section.settings.background == 'beige' %} section--beige{% elsif section.settings.background == 'cocoa' %} section--cocoa{% endif %}">
  <div class="page-width page-width--narrow">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="section-head__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="table-wrap reveal">
      <table class="nutri-table compare">
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col" class="compare__us">{{ section.settings.col_us }}</th>
            <th scope="col">{{ section.settings.col_them }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row" style="font-weight:600;">{{ block.settings.label }}</th>
              <td class="compare__us">
                {%- if block.settings.us_check -%}
                  <span class="compare__tick">{% render 'icon', name: 'check' %}</span>
                {%- endif -%}
                {%- if block.settings.us_text != blank %}<span>{{ block.settings.us_text }}</span>{% endif -%}
              </td>
              <td class="muted">{{ block.settings.them_text }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="muted" style="font-size:var(--fs-xs);margin-top:16px;">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .compare .compare__us{ background:rgba(245,166,35,.1); }
  .compare thead .compare__us{ background:var(--nd-gold); color:var(--nd-cocoa-deep); }
  .compare td{ vertical-align:middle; }
  .compare__tick{
    display:inline-grid; place-items:center; width:20px; height:20px; margin-right:6px;
    border-radius:var(--r-pill); background:var(--nd-gold); color:var(--nd-cocoa-deep); vertical-align:-4px;
  }
  .compare__tick svg{ width:12px; height:12px; }
</style>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Honest comparison" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How NutriDates stacks up." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "col_us", "label": "Our column heading", "default": "NutriDates" },
    { "type": "text", "id": "col_them", "label": "Their column heading", "default": "Typical drink mix" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Comparison based on commonly available products. Always check individual labels." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "Warm white" },
        { "value": "cream", "label": "Warm cream" },
        { "value": "beige", "label": "Soft beige" },
        { "value": "cocoa", "label": "Cocoa" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Attribute", "default": "Protein per serving" },
        { "type": "checkbox", "id": "us_check", "label": "Show tick in our column", "default": true },
        { "type": "text", "id": "us_text", "label": "Our value", "default": "11g" },
        { "type": "text", "id": "them_text", "label": "Their value", "default": "Typically 1-3g" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "label": "Protein per 32g serving", "us_text": "11g", "them_text": "Typically 1-3g" } },
        { "type": "row", "settings": { "label": "Sweetness from dates", "us_text": "Yes", "them_text": "Usually added sugar" } },
        { "type": "row", "settings": { "label": "Oats and dry fruits", "us_text": "Included", "them_text": "Rarely" } },
        { "type": "row", "settings": { "label": "Prep time", "us_text": "30 seconds", "them_text": "30 seconds" } }
      ]
    }
  ]
}
{% endschema %}
