{{ 'section-hero.css' | asset_url | stylesheet_tag }}

<section class="hero hero--{{ section.settings.height }}" style="--hero-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      <img class="hero__img hide-mobile"
           src="{{ section.settings.image | image_url: width: 2400 }}"
           srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w,
                   {{ section.settings.image | image_url: width: 1800 }} 1800w,
                   {{ section.settings.image | image_url: width: 2400 }} 2400w"
           sizes="100vw"
           alt="{{ section.settings.image.alt | escape }}"
           width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
           fetchpriority="high">
    {%- endif -%}
    {%- if section.settings.image_mobile != blank -%}
      <img class="hero__img hide-desktop"
           src="{{ section.settings.image_mobile | image_url: width: 1200 }}"
           alt="{{ section.settings.image_mobile.alt | escape }}"
           width="{{ section.settings.image_mobile.width }}" height="{{ section.settings.image_mobile.height }}"
           fetchpriority="high">
    {%- elsif section.settings.image != blank -%}
      {%- comment -%}Desktop image reused on mobile{%- endcomment -%}
      <img class="hero__img hide-desktop"
           src="{{ section.settings.image | image_url: width: 1200 }}"
           alt="{{ section.settings.image.alt | escape }}" fetchpriority="high">
    {%- endif -%}
    {%- if section.settings.image == blank -%}
      {%- comment -%}Falls back to the packaged NutriDates artwork{%- endcomment -%}
      <img class="hero__img" src="{{ section.settings.fallback_asset | asset_url }}"
           alt="NutriDates Cocoa Dates Milkshake Mix" fetchpriority="high">
    {%- endif -%}
  </div>

  {%- unless section.settings.image_only -%}
  <div class="hero__inner page-width hero__inner--{{ section.settings.text_align }}">
    <div class="hero__content">
      {%- if section.settings.badge != blank -%}
        <span class="hero__badge">{{ section.settings.badge }}</span>
      {%- endif -%}

      <h1 class="hero__title">{{ section.settings.heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="hero__stats">
          {%- for block in section.blocks -%}
            <li class="hero__stat" {{ block.shopify_attributes }}>
              <span class="hero__stat-value">{{ block.settings.value }}</span>
              <span class="hero__stat-label">{{ block.settings.label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="hero__actions">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url }}" class="btn btn--gold btn--lg">{{ section.settings.cta_text }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_url }}" class="btn btn--light btn--lg">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- endunless -%}

  {%- if section.settings.image_only and section.settings.cta_url != blank -%}
    <a class="hero__full-link" href="{{ section.settings.cta_url }}" aria-label="{{ section.settings.heading | escape }}"></a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    {
      "type": "checkbox",
      "id": "image_only",
      "label": "Image-only banner",
      "default": false,
      "info": "Hides the text overlay so the whole banner is your uploaded artwork, and makes it clickable. Use this when the headline is baked into the image."
    },
    {
      "type": "select",
      "id": "fallback_asset",
      "label": "Placeholder artwork",
      "info": "Shown until you upload your own banner image.",
      "options": [
        { "value": "nd-product-hero.png", "label": "Product hero" },
        { "value": "nd-mockup-kitchen.jpg", "label": "Kitchen mockup" },
        { "value": "nd-mockup-pedestal.jpg", "label": "Pedestal mockup" }
      ],
      "default": "nd-mockup-kitchen.jpg"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "lg"
    },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image overlay", "default": 30 },
    {
      "type": "select",
      "id": "text_align",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "New · Cocoa Dates Milkshake Mix" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chocolate that works harder." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Dates, cocoa and protein in one 30-second shake. Sip The Strength." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop now" },
    { "type": "url", "id": "cta_url", "label": "Primary button link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button" },
    { "type": "url", "id": "cta2_url", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "17g" },
        { "type": "text", "id": "label", "label": "Label", "default": "Protein with milk" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "17g", "label": "Protein with milk" } },
        { "type": "stat", "settings": { "value": "133", "label": "kcal per serving" } },
        { "type": "stat", "settings": { "value": "30s", "label": "Prep time" } }
      ]
    }
  ]
}
{% endschema %}
